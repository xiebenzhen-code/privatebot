# 复制为 .env 后填写。生成令牌：openssl rand -hex 24
WB_TOKEN=
# 网页登录密码（≥12 位，给人和浏览器用；脚本用上面的 WB_TOKEN）
WB_PASSWORD=

# 页面上显示时间、按天统计用的时区
WB_TZ=Asia/Shanghai

# ---------- 谁能访问工作台（024）----------
# 默认只绑本机：只有这台电脑能打开 http://localhost:3200。
# 想让同一 Wi-Fi 下的手机/平板访问，改成 0.0.0.0，然后重建容器：
#   WB_BIND=0.0.0.0
# 注意：局域网里走的是明文 HTTP，别在公司、咖啡店这类共用网络上这样开。
# 出门用手机请走 Tailscale（见 README 的「手机访问」），
# **任何情况下都不要在路由器上给这个端口做端口转发**——它能批准任意命令。
# WB_BIND=0.0.0.0
#
# 不用 Docker、直接 `npm start` 时，WB_BIND 不管用，看的是 HOST（024a.1）：
# 不设就是 127.0.0.1（只有本机能开）；要让局域网访问才写 HOST=0.0.0.0，风险同上。
# HOST=0.0.0.0

# ---------- 公网访问检测（024b）----------
# warn（默认）= 页面顶部提醒你，并且一天记一条审计、推一次消息；
# refuse = 直接拒绝网页访问（脚本接口照常）；allow = 不处理。
# WB_PUBLIC_ACCESS=warn
# 你确实有自己的域名（比如放在带 HTTPS 的反向代理后面）时填进来，这些主机名就不再提醒。
# WB_ALLOWED_HOSTS=wb.example.com

# 拉不到 Docker Hub 的 node:22-slim 时，换成能访问的镜像源（需 Node ≥ 22.18）
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-slim

# ---------- CLIProxyAPI 连接器（可选，三项都不设就不启用）----------
# CLIProxyAPI 的管理接口地址。容器内用服务名（需与 CLIProxyAPI 在同一 Docker 网络），
# 本机直跑用 http://localhost:8317
# CPA_URL=http://cliproxyapi:8317
# 管理密钥（CLIProxyAPI 的 management.secret-key），别提交
# CPA_MANAGEMENT_KEY=
# 采集间隔秒数，默认 60，最小 15
# CPA_POLL_SECONDS=60

# 想让工作台容器按服务名访问 CLIProxyAPI 时，接上一个外部 Docker 网络：
# WB_CPA_NETWORK=ai-net
# WB_CPA_EXTERNAL=true

# ---------- 余额连接器（可选，不设就不启用）----------
# DeepSeek 的 API key，用于定时查询账户余额
# DEEPSEEK_API_KEY=

# ---------- GLM Coding Plan（ZCode，可选）----------
# 智谱 API key；区域 cn=open.bigmodel.cn，intl=api.z.ai
# ZAI_API_KEY=
# ZAI_REGION=cn

# ---------- GitHub 任务通道（012，可选）----------
# GitHub 令牌只填执行器配置的 githubToken，不填工作台 .env。
# 只盯这些仓库，逗号分隔，写成 用户名/仓库名
# GITHUB_REPOS=你的GitHub用户名/ai-workbench
# 只收这些人开的 Issue 和指令评论，逗号分隔。
# 默认是空的 = 谁的都不收（防止陌生人在你的机器上派活），要用就必须填上自己的用户名。
# GITHUB_ALLOWED_AUTHORS=你的GitHub用户名
#
# 035 自己开发自己（可选）：执行器每 5 分钟读一次这个仓库的 docs/specs/queue.json，
# 把排到 ready 的项建成任务（仍然要你点「开始」）。不填就用 GITHUB_REPOS 的第一个。
# WB_SELF_REPO=你的GitHub用户名/ai-workbench
# 这些任务派给执行器里的哪个项目，默认 ai-workbench
# WB_SELF_PROJECT=ai-workbench

# ---------- 自动备份（014）----------
# 备份写到这台电脑上的哪个文件夹。可以是网盘的同步目录（OneDrive、坚果云、Google 云端硬盘
# 的「我的电脑」同步文件夹等），这样自动就有异地副本。不设就用仓库下的 ./backups。
# 路径里有空格或中文也能用；写成 C:/Users/你/wb-backups 这种正斜杠形式最稳。
# WB_BACKUP_DIR=C:/Users/你/wb-backups
# 备份文件名里的项目名，默认 ai-workbench
# WB_BACKUP_NAME=ai-workbench
# 每天几点备份，24 小时制 HH:MM，默认 03:30，时区按上面的 WB_TZ
# WB_BACKUP_AT=03:30
# 临时关掉自动备份。恢复演练、起临时实例时设成 1，免得跟正式实例抢着写
# WB_BACKUP_OFF=1
# 只有不用 Docker、直接 node src/server.ts 时才需要（容器里固定是 /backups）
# WB_BACKUP_PATH=C:/Users/你/wb-backups
